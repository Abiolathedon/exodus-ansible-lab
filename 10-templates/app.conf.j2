# ================================================================
# EXODUS monitoring agent config - generated from a template.
# Lines with double-curly-braces are BLANKS filled in per host.
# ================================================================

# --- identity of THIS server (filled in per host) ---
# hostname = the server's name from the inventory
hostname = {{ inventory_hostname }}

# ip_address = this server's real IP address (a fact)
ip_address = {{ ansible_default_ipv4.address }}

# --- settings that are the SAME on every host (from a variable) ---
# metrics_port and environment come from variables in the playbook
metrics_port = {{ metrics_port }}
environment = {{ deploy_environment }}
